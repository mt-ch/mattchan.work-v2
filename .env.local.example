NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=v2
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Absolute site origin, used as the metadataBase for SEO/social metadata.
# Falls back to http://localhost:3000 in development when unset.
NEXT_PUBLIC_SITE_URL=

# Shared secret configured on the v2 Sanity webhook that hits /api/revalidate.
SANITY_REVALIDATE_SECRET=
